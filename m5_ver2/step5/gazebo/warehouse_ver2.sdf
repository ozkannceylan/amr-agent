    <!-- ===================== Step 5 station paint ===================== -->
    <!-- Ten pick/charge/dock stations. ipc/stations.py is the one home
         for these poses; tests/test_stations_sdf.py fails the build if
         this paint and that file disagree. Same recipe as the charge-bay
         markings above: static, visual-only, <= 8 mm proud, so neither
         scan plane nor the nav lidar ever sees them. The tick shows the
         approach heading (stations.py yaw). -->
    <model name="StationS1Paint">
      <static>true</static>
      <pose>-3.000 -5.500 0 0 0 0</pose>
      <link name="link">
        <visual name="disc">
          <pose>0 0 0.003 0 0 0</pose>
          <geometry><cylinder><radius>0.40</radius><length>0.006</length></cylinder></geometry>
          <material><ambient>0.10 0.35 0.75 1</ambient><diffuse>0.10 0.35 0.75 1</diffuse></material>
        </visual>
