    <!-- ==================== Transfer station (M6) ===================== -->
    <!-- The conveyor deck against the east wall. The S7 1500 owns this
         equipment at M6 (ADR 0010); this file carries its shape and
         nothing else. The source world's TransferStationFrame posts are
         deliberately absent (owner instruction 2026-08-12: no grey
         columns), so the 0.80 m deck below the navigation plane is seen
         by the safety scanners only. -->
    <model name="ConveyorStation">
      <static>true</static>
      <link name="link">
        <collision name="conveyorstation_collision">
          <pose>14.450 5.000 0.400 0 0 0</pose>
