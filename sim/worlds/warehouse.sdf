    <!-- ======================= Building columns ======================= -->
    <!-- 0.25 m steel columns on the building grid: x = +-4.60 and +-13.40,
         on three lines in y. The two inner lines fall in the back to back
         flues of rows B and C, which is how a real layout reconciles a
         column grid with racking, so those columns are seen from an aisle
         only through an empty bay. The apron line is exposed. No column
         stands in the central cross aisle or in the dock door approach
         (x in [4.00, 8.00]); the grid was set out that way. -->
    <model name="BuildingColumns">
      <static>true</static>
      <link name="link">
        <collision name="column_rowB_flue_m13p4_collision">
          <pose>-13.400 3.850 2.000 0 0 0</pose>
