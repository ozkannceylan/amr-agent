    <!-- ==================== Transfer station (M6) ===================== -->
    <!-- The conveyor transfer station against the east wall. The S7 1500
         owns this equipment at M6 (ADR 0010); this file carries its shape
         and nothing else. The 0.80 m deck is BELOW the navigation scan
         plane and is seen only by the safety scanners; the two guard frame
         posts are what the navigation lidar sees of the station. -->
    <model name="ConveyorStation">
      <static>true</static>
      <link name="link">
        <collision name="conveyorstation_collision">
          <pose>14.450 5.000 0.400 0 0 0</pose>
          <geometry><box><size>0.900 3.000 0.800</size></box></geometry>
        </collision>
        <visual name="conveyorstation_visual">
          <pose>14.450 5.000 0.400 0 0 0</pose>
          <geometry><box><size>0.900 3.000 0.800</size></box></geometry>
          <material><ambient>0.15 0.60 0.25 1</ambient><diffuse>0.15 0.60 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>

