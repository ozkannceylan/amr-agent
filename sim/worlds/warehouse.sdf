    <!-- ========================= Charging bays ======================== -->
    <!-- Geometry plus names, and nothing else. See the file header for the
         sizing arithmetic, for what each part shows at each scan plane, and
         for why the M3 era ChargerStation block is gone rather than kept
         beside these. worlds/WAREHOUSE_EVIDENCE.md section 5 is the
         document a later fleet brief cites for these poses. -->
    <!-- Bay 1 outline. Paint: no collision, 6 mm proud, seen by neither scan plane. -->
    <model name="ChargeBay1Marking">
      <static>true</static>
      <pose>-9.800 -7.700 0 0 0 0</pose>
      <link name="link">
