            <diffuse>0.55 0.55 0.58 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="RackNE2">
      <static>true</static>
      <pose>10.000 4.250 2.000 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>2.000 3.500 4.000</size></box></geometry>
