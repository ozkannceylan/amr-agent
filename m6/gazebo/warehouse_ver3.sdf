          <geometry><box><size>1.000 3.500 4.000</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.000 3.500 4.000</size></box></geometry>
          <material>
            <ambient>0.45 0.45 0.48 1</ambient>
            <diffuse>0.55 0.55 0.58 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="RackNE1">
      <static>true</static>
      <pose>4.500 4.250 2.000 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.000 3.500 4.000</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.000 3.500 4.000</size></box></geometry>
          <material>
