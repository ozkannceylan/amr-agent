    <link name="body">
      <collision name="c">
        <geometry><box><size>0.08 1.00 0.06</size></box></geometry>
      </collision>
      <visual name="v">
        <geometry><box><size>0.08 1.00 0.06</size></box></geometry>
        <material><ambient>0.45 0.32 0.18 1</ambient><diffuse>0.45 0.32 0.18 1</diffuse></material>
      </visual>
    </link>
  </model>
</sdf>
